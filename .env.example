# TMDB API key — SADECE sunucu tarafında kullanılır (app/api/tmdb/*).
# https://www.themoviedb.org/settings/api adresinden alınır.
# v3 API key (32 karakter) ya da v4 Read Access Token (eyJ... ile başlar) verilebilir.
TMDB_API_KEY=

# Metadata dili ve bölgesi (opsiyonel)
TMDB_LANGUAGE=tr-TR
TMDB_REGION=TR
